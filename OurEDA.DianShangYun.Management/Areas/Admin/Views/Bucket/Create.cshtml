
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/Bucket/_Layout.cshtml";
}
<div class="row">
    <div class="col-md-12">
        <!-- BEGIN VALIDATION STATES-->
        <div class="portlet box blue">
            <div class="portlet-title">
                <div class="caption"><i class="fa fa-reorder"></i>创建空间</div>
                
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form action="~/Admin/Bucket/Create" class="form-horizontal" method="post">
                    <div class="form-body">
                        <div class="note note-danger">
                            <h4 class="block">注意！</h4>
                            <p>
                                空间名称在全网中唯一，遇到冲突请更换名称。
                                
                            </p>
                        <p>
                            空间名应为字母或者数字,英文大写将自动转化为小写!
                        </p>
                        </div><div class="form-group has-warning">
                            <label class="control-label col-md-3" for="inputWarning">名称</label>
                            <div class="col-md-4">
                                <input type="text" class="form-control" id="inputWarning" name="name">
                                <span class="help-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions fluid">
                        <div class="col-md-offset-3 col-md-9">
                            <button type="submit" class="btn green">确定</button>
                            <a href="~/admin/bucket/index" type="button" class="btn default">取消</a>
                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            </div>
        </div>
        <!-- END VALIDATION STATES-->
    </div>
</div>

