@model OurEDA.DianShangYun.Management.Areas.Admin.Models.MongoDB.Bucket
@{
    Layout = "~/Areas/Admin/Views/Shared/Bucket/_ContentLayout.cshtml";
}
<div class="page-sidebar navbar-collapse collapse">
    <ul class="page-sidebar-menu">
        <li>
            <!-- BEGIN SIDEBAR TOGGLER BUTTON -->
            <div class="sidebar-toggler hidden-sm hidden-xs"></div>
            <!-- BEGIN SIDEBAR TOGGLER BUTTON -->
        </li>
        <li class="start">
            <a href="~/Admin/Bucket/Management/@Model.ID">
                <i class="fa fa-cogs"></i>
                <span class="title">内容管理</span>
                <span class="selected "></span>
            </a>
        </li>
        <li class="active">
            <a href="~/Admin/Bucket/Config/@Model.ID">
                <i class="fa fa-cogs"></i>
                <span class="title">空间配置</span>
                <span class="selected "></span>
            </a>
        </li>
        <li>
            <a href="~/Admin/Bucket/Index">
                <i class="fa fa-cogs"></i>
                <span class="title">返回</span>
                <span class="selected "></span>
            </a>
        </li>
    </ul>
</div>
<!-- END SIDEBAR -->
<!-- BEGIN PAGE -->
<div class="page-content">
    <div class="row">
        <div class="col-md-6">
            <div class="portlet box purple ">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i> Bucket 信息
                    </div>
                    <div class="tools">
                    </div>
                </div>
                <div class="portlet-body form">
                    <form class="form-horizontal" role="form">
                        <div class="form-body">
                            <div class="form-group">
                                <label class="col-md-3 control-label">Access Id</label>
                                <div class="col-md-9">
                                    <label class="col-md-3 control-label">@Model.ID.ToString()</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-md-3 control-label">SECRET KEY</label>
                                <div class="col-md-9">
                                    <label class="col-md-3 control-label">@Model.SECRET_KEY</label>
                                </div>
                            </div>                            
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

